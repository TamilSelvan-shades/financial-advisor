# ==== Database ====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_production_secure_password
POSTGRES_DB=finance_db

# Override the database URL in docker-compose.prod.yml, but keep here for reference
# DATABASE_URL=postgresql://postgres:your_production_secure_password@db:5432/finance_db

# ==== Security ====
JWT_SECRET=your_super_secret_jwt_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_CORS_ORIGINS=["https://your-production-domain.com", "https://www.your-production-domain.com"]

# ==== External APIs ====
RAZORPAY_KEY_ID=rzp_live_your_production_key_id
RAZORPAY_KEY_SECRET=your_production_key_secret

# Optional Services
TELEGRAM_BOT_TOKEN=your_production_telegram_bot_token
TELEGRAM_CHAT_ID=your_production_telegram_chat_id
WHATSAPP_API_URL=https://api.whatsapp.com/v1/messages
WHATSAPP_TOKEN=your_production_whatsapp_token
OPENAI_API_KEY=your_production_openai_api_key
